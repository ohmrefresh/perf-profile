# .env.example — copy to .env and fill in values

# Required: Prometheus endpoint
PROMETHEUS_URL=http://prometheus:9090

# MCP server transport: stdio | sse
MCP_TRANSPORT=sse

# SSE server bind
MCP_PORT=3000
MCP_HOST=0.0.0.0

# Prometheus request timeout (ms)
PROMETHEUS_TIMEOUT_MS=10000

# Max concurrent Prometheus queries (semaphore pool size)
MAX_CONCURRENT=4

# Logging: debug | info | warn | error
LOG_LEVEL=info
